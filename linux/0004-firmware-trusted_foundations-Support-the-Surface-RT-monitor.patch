From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dennis Palmer <dodava@gmail.com>
Date: Wed, 21 Oct 2026 13:43:47 +0200
Subject: [PATCH] firmware: trusted_foundations: Support the Surface RT monitor

When the Microsoft Surface RT boots Linux through UEFI, the kernel runs
in the non-secure world, and the Tegra CPU reset handler's errata writes
to the Cortex-A9 diagnostic register fault on the secondary CPUs. They
never come online. The reset handler skips those writes when Trusted
Foundations is registered, but the Surface RT's secure monitor doesn't
take Trusted Foundations calls.

Add a tlm,microsoft-surface-rt property that registers the firmware with
no operations. That marks it as present without making any secure calls,
and the kernel writes the CPU reset vector itself.

Based on the Open Surface RT community kernel (grate-linux,
microsoft-surface-rt branch), which also turns on the L2 cache through
the monitor. That part isn't included here.

---
 drivers/firmware/trusted_foundations.c        | 20 ++++++++++++++++++--
 include/linux/firmware/trusted_foundations.h  |  1 +
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/drivers/firmware/trusted_foundations.c b/drivers/firmware/trusted_foundations.c
--- a/drivers/firmware/trusted_foundations.c
+++ b/drivers/firmware/trusted_foundations.c
@@ -140,6 +140,16 @@
 }
 #endif /* CONFIG_CACHE_L2X0 */
 
+/*
+ * The Microsoft Surface RT's secure monitor isn't Trusted Foundations and
+ * doesn't take its calls. Registering it still marks the firmware as
+ * present, so the CPU reset handler skips the secure-only errata writes
+ * and the secondary CPUs can come online. Without set_cpu_boot_addr, the
+ * kernel writes the CPU reset vector itself.
+ */
+static const struct firmware_ops trusted_foundations_surface_ops = {
+};
+
 static const struct firmware_ops trusted_foundations_ops = {
 	.set_cpu_boot_addr = tf_set_cpu_boot_addr,
 	.prepare_idle = tf_prepare_idle,
@@ -154,7 +164,10 @@
 	 * we are not using version information for now since currently
 	 * supported SMCs are compatible with all TF releases
 	 */
-	register_firmware_ops(&trusted_foundations_ops);
+	if (pd->is_surface_rt)
+		register_firmware_ops(&trusted_foundations_surface_ops);
+	else
+		register_firmware_ops(&trusted_foundations_ops);
 }
 
 void of_register_trusted_foundations(void)
@@ -175,10 +188,13 @@
 				   &pdata.version_minor);
 	if (err != 0)
 		panic("Trusted Foundation: missing version-minor property\n");
+	pdata.is_surface_rt = of_property_read_bool(node,
+						    "tlm,microsoft-surface-rt");
 	register_trusted_foundations(&pdata);
 }
 
 bool trusted_foundations_registered(void)
 {
-	return firmware_ops == &trusted_foundations_ops;
+	return firmware_ops == &trusted_foundations_ops ||
+	       firmware_ops == &trusted_foundations_surface_ops;
 }
diff --git a/include/linux/firmware/trusted_foundations.h b/include/linux/firmware/trusted_foundations.h
--- a/include/linux/firmware/trusted_foundations.h
+++ b/include/linux/firmware/trusted_foundations.h
@@ -37,6 +37,7 @@
 struct trusted_foundations_platform_data {
 	unsigned int version_major;
 	unsigned int version_minor;
+	bool is_surface_rt;
 };
 
 #if IS_ENABLED(CONFIG_TRUSTED_FOUNDATIONS)
