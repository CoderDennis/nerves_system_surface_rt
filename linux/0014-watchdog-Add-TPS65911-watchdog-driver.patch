diff --git a/drivers/watchdog/tps65911_wdt.c b/drivers/watchdog/tps65911_wdt.c
new file mode 100644
index 0000000..7140ac7
--- /dev/null
+++ b/drivers/watchdog/tps65911_wdt.c
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Watchdog driver for the TI TPS65911 PMIC
+ *
+ * In periodic mode, the PMIC raises its watchdog interrupt once per
+ * period. If the interrupt is still pending at the end of the next
+ * period, the PMIC switches the system off, and back on again if the
+ * DEV_ON bit is set. Pinging the watchdog clears the interrupt, so the
+ * system is switched off between one and two periods after the last ping.
+ *
+ * The watchdog setting survives the PMIC's own switch-off. Only a general
+ * reset of the PMIC (e.g. a long press of the power button) clears it, so
+ * after the watchdog has fired, it's still running when the system boots
+ * again. This driver stops it on reboot and power-off, so finding it
+ * running at probe means that it most likely fired.
+ */
+
+#include <linux/kernel.h>
+#include <linux/mfd/tps65910.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/watchdog.h>
+
+/* WTCHDG_TIME to period in seconds. 0 disables the watchdog. */
+static const unsigned int tps65911_wdt_periods[] = {
+	0, 5, 10, 20, 40, 60, 80, 100
+};
+
+#define TPS65911_WDT_SEL_MIN		1
+#define TPS65911_WDT_SEL_MAX		(ARRAY_SIZE(tps65911_wdt_periods) - 1)
+#define TPS65911_WDT_DEFAULT_TIMEOUT	100
+
+static unsigned int tps65911_wdt_timeout_to_sel(unsigned int timeout)
+{
+	unsigned int i;
+
+	for (i = TPS65911_WDT_SEL_MIN; i <= TPS65911_WDT_SEL_MAX; i++) {
+		if (tps65911_wdt_periods[i] >= timeout)
+			return i;
+	}
+
+	return TPS65911_WDT_SEL_MAX;
+}
+
+static int tps65911_wdt_clear_irq(struct tps65910 *tps65910)
+{
+	/* The interrupt status bits are cleared by writing 1 */
+	return regmap_write(tps65910->regmap, TPS65910_INT_STS3,
+			    INT_STS3_WTCHDG_IT_MASK);
+}
+
+static int tps65911_wdt_write_sel(struct tps65910 *tps65910, unsigned int sel)
+{
+	/* WTCHDG_MODE = 0 selects periodic mode */
+	return regmap_write(tps65910->regmap, TPS65911_WATCHDOG,
+			    sel << WATCHDOG_WTCHDG_TIME_SHIFT);
+}
+
+static int tps65911_wdt_start(struct watchdog_device *wdd)
+{
+	struct tps65910 *tps65910 = watchdog_get_drvdata(wdd);
+	int ret;
+
+	ret = tps65911_wdt_clear_irq(tps65910);
+	if (ret)
+		return ret;
+
+	return tps65911_wdt_write_sel(tps65910,
+				      tps65911_wdt_timeout_to_sel(wdd->timeout));
+}
+
+static int tps65911_wdt_stop(struct watchdog_device *wdd)
+{
+	struct tps65910 *tps65910 = watchdog_get_drvdata(wdd);
+
+	return tps65911_wdt_write_sel(tps65910, 0);
+}
+
+static int tps65911_wdt_ping(struct watchdog_device *wdd)
+{
+	struct tps65910 *tps65910 = watchdog_get_drvdata(wdd);
+
+	/*
+	 * Don't ping late in a reboot or power-off, when the restart and
+	 * power-off handlers may need the I2C bus.
+	 */
+	if (system_state > SYSTEM_RUNNING)
+		return 0;
+
+	return tps65911_wdt_clear_irq(tps65910);
+}
+
+static int tps65911_wdt_set_timeout(struct watchdog_device *wdd,
+				    unsigned int timeout)
+{
+	struct tps65910 *tps65910 = watchdog_get_drvdata(wdd);
+	unsigned int sel = tps65911_wdt_timeout_to_sel(timeout);
+	int ret;
+
+	if (watchdog_hw_running(wdd)) {
+		ret = tps65911_wdt_write_sel(tps65910, sel);
+		if (ret)
+			return ret;
+	}
+
+	wdd->timeout = tps65911_wdt_periods[sel];
+
+	return 0;
+}
+
+static const struct watchdog_info tps65911_wdt_info = {
+	.options = WDIOF_SETTIMEOUT | WDIOF_KEEPALIVEPING | WDIOF_CARDRESET,
+	.identity = "TPS65911 Watchdog",
+};
+
+static const struct watchdog_ops tps65911_wdt_ops = {
+	.owner = THIS_MODULE,
+	.start = tps65911_wdt_start,
+	.stop = tps65911_wdt_stop,
+	.ping = tps65911_wdt_ping,
+	.set_timeout = tps65911_wdt_set_timeout,
+};
+
+static int tps65911_wdt_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct tps65910 *tps65910 = dev_get_drvdata(dev->parent);
+	struct watchdog_device *wdd;
+	unsigned int val, sel;
+	int ret;
+
+	wdd = devm_kzalloc(dev, sizeof(*wdd), GFP_KERNEL);
+	if (!wdd)
+		return -ENOMEM;
+
+	ret = regmap_read(tps65910->regmap, TPS65911_WATCHDOG, &val);
+	if (ret)
+		return ret;
+
+	wdd->info = &tps65911_wdt_info;
+	wdd->ops = &tps65911_wdt_ops;
+	wdd->min_timeout = tps65911_wdt_periods[TPS65911_WDT_SEL_MIN];
+	wdd->max_timeout = tps65911_wdt_periods[TPS65911_WDT_SEL_MAX];
+	wdd->timeout = TPS65911_WDT_DEFAULT_TIMEOUT;
+	wdd->parent = dev;
+	wdd->status = WATCHDOG_NOWAYOUT_INIT_STATUS;
+	watchdog_set_drvdata(wdd, tps65910);
+	watchdog_stop_on_reboot(wdd);
+	watchdog_init_timeout(wdd, 0, dev);
+
+	sel = (val & WATCHDOG_WTCHDG_TIME_MASK) >> WATCHDOG_WTCHDG_TIME_SHIFT;
+	if (sel) {
+		/* Still running, most likely because it fired */
+		wdd->bootstatus = WDIOF_CARDRESET;
+
+		ret = tps65911_wdt_start(wdd);
+		if (ret)
+			return ret;
+
+		set_bit(WDOG_HW_RUNNING, &wdd->status);
+	}
+
+	return devm_watchdog_register_device(dev, wdd);
+}
+
+static struct platform_driver tps65911_wdt_driver = {
+	.probe = tps65911_wdt_probe,
+	.driver = {
+		.name = "tps65911-watchdog",
+	},
+};
+module_platform_driver(tps65911_wdt_driver);
+
+MODULE_DESCRIPTION("TI TPS65911 watchdog driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:tps65911-watchdog");
diff --git a/include/linux/mfd/tps65910.h b/include/linux/mfd/tps65910.h
index f67ef0a..f33b8f2 100644
--- a/include/linux/mfd/tps65910.h
+++ b/include/linux/mfd/tps65910.h
@@ -119,6 +119,7 @@
 #define TPS65911_LDO6					0x35
 #define TPS65911_LDO4					0x36
 #define TPS65911_LDO3					0x37
+#define TPS65911_WATCHDOG				0x69
 #define TPS65911_VMBCH					0x6A
 #define TPS65911_VMBCH2					0x6B
 
@@ -749,6 +750,12 @@
 #define VDDCTRL_ST_SHIFT                                 0
 
 
+/*Register WATCHDOG  (0x69) bit definitions */
+#define WATCHDOG_WTCHDG_MODE_MASK			0x08
+#define WATCHDOG_WTCHDG_MODE_SHIFT			3
+#define WATCHDOG_WTCHDG_TIME_MASK			0x07
+#define WATCHDOG_WTCHDG_TIME_SHIFT			0
+
 /*Register VDDCTRL_OP  (0x28) bit definitions */
 #define VDDCTRL_OP_CMD_MASK                              0x80
 #define VDDCTRL_OP_CMD_SHIFT                             7
