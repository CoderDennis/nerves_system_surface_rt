--- a/drivers/watchdog/Kconfig
+++ b/drivers/watchdog/Kconfig
@@ -710,6 +710,18 @@ config TWL4030_WATCHDOG
 	  Support for TI TWL4030 watchdog.  Say 'Y' here to enable the
 	  watchdog timer support for TWL4030 chips.
 
+config TPS65911_WATCHDOG
+	tristate "TI TPS65911 Watchdog"
+	depends on MFD_TPS65910
+	select WATCHDOG_CORE
+	help
+	  Support for the watchdog in the TI TPS65911 PMIC. When it expires,
+	  the PMIC switches the system off, and back on if the DEV_ON bit is
+	  set.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called tps65911_wdt.
+
 config STMP3XXX_RTC_WATCHDOG
 	tristate "Freescale STMP3XXX & i.MX23/28 watchdog"
 	depends on RTC_DRV_STMP || COMPILE_TEST
