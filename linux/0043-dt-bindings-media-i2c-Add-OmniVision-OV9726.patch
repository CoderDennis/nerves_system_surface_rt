From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dennis Palmer <dodava@gmail.com>
Date: Thu, 22 Oct 2026 15:29:55 +0200
Subject: [PATCH] dt-bindings: media: i2c: Add OmniVision OV9726

Add a binding for the OmniVision OV9726, a 1280x800 CMOS image sensor
with a one-lane MIPI CSI-2 interface. The Microsoft Surface RT uses two
of them, as its front and rear cameras.

Signed-off-by: Dennis Palmer <dodava@gmail.com>
---
 .../bindings/media/i2c/ovti,ov9726.yaml       | 99 +++++++++++++++++++
 1 file changed, 99 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/ovti,ov9726.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/ovti,ov9726.yaml b/Documentation/devicetree/bindings/media/i2c/ovti,ov9726.yaml
new file mode 100644
index 000000000..fb0762caf
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov9726.yaml
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov9726.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV9726 Image Sensor
+
+maintainers:
+  - Dennis Palmer <dodava@gmail.com>
+
+description:
+  The OmniVision OV9726 is a 1/6.5-inch 1280x800 CMOS image sensor with a
+  one-lane MIPI CSI-2 interface, controlled over I2C.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov9726
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: Input clock (XVCLK), 24 MHz
+    maxItems: 1
+
+  dovdd-supply:
+    description: Digital I/O supply, 1.8 V
+
+  avdd-supply:
+    description: Analog supply, 2.8 V
+
+  reset-gpios:
+    description: Reset pin (RESETB), active low
+    maxItems: 1
+
+  powerdown-gpios:
+    description: Power-down pin (PWDN), active high
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - dovdd-supply
+  - avdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@10 {
+            compatible = "ovti,ov9726";
+            reg = <0x10>;
+
+            clocks = <&camera_clk>;
+            reset-gpios = <&gpio 216 GPIO_ACTIVE_LOW>;
+            dovdd-supply = <&vdd_1v8_cam>;
+            avdd-supply = <&vdd_2v8_cam>;
+
+            port {
+                endpoint {
+                    data-lanes = <1>;
+                    link-frequencies = /bits/ 64 <210000000>;
+                    remote-endpoint = <&csi_input>;
+                };
+            };
+        };
+    };
+...
-- 
2.55.0

