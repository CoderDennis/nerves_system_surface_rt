From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dennis Palmer <dodava@gmail.com>
Date: Thu, 22 Oct 2026 15:29:55 +0200
Subject: [PATCH] media: i2c: Add OmniVision OV9726 sensor driver

Add a V4L2 subdev driver for the OmniVision OV9726, a 1/6.5" 1280x800
CMOS image sensor with a one-lane MIPI CSI-2 interface.

The driver supports one mode: 1296x808 (the 1280x800 active area plus
border pixels) RAW10 at 30 fps from a 24 MHz input clock. The register
settings come from NVIDIA's Tegra 3 Android driver. It has exposure,
analogue gain, vertical blanking, flip and test pattern controls.

Signed-off-by: Dennis Palmer <dodava@gmail.com>
---
 drivers/media/i2c/Kconfig  |  10 +
 drivers/media/i2c/Makefile |   1 +
 drivers/media/i2c/ov9726.c | 751 +++++++++++++++++++++++++++++++++++++
 3 files changed, 762 insertions(+)
 create mode 100644 drivers/media/i2c/ov9726.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index cdd7ba5da..9a3807c69 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -687,6 +687,16 @@ config VIDEO_OV9650
 	  This is a V4L2 sensor driver for the Omnivision
 	  OV9650 and OV9652 camera sensors.
 
+config VIDEO_OV9726
+	tristate "OmniVision OV9726 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the OmniVision
+	  OV9726 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module's name is ov9726.
+
 config VIDEO_OV9734
 	tristate "OmniVision OV9734 sensor support"
 	depends on ACPI || COMPILE_TEST
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 57cdd8dc9..e1060c9f4 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -119,6 +119,7 @@ obj-$(CONFIG_VIDEO_OV8865) += ov8865.o
 obj-$(CONFIG_VIDEO_OV9282) += ov9282.o
 obj-$(CONFIG_VIDEO_OV9640) += ov9640.o
 obj-$(CONFIG_VIDEO_OV9650) += ov9650.o
+obj-$(CONFIG_VIDEO_OV9726) += ov9726.o
 obj-$(CONFIG_VIDEO_OV9734) += ov9734.o
 obj-$(CONFIG_VIDEO_RDACM20) += rdacm20.o
 obj-$(CONFIG_VIDEO_RDACM21) += rdacm21.o
diff --git a/drivers/media/i2c/ov9726.c b/drivers/media/i2c/ov9726.c
new file mode 100644
index 000000000..22b8e1b65
--- /dev/null
+++ b/drivers/media/i2c/ov9726.c
@@ -0,0 +1,751 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OmniVision OV9726 1/6.5" 1MP CMOS image sensor driver
+ *
+ * The register settings come from NVIDIA's Tegra 3 Android driver
+ * (drivers/media/video/tegra/ov9726.c, Copyright (c) 2011-2013, NVIDIA
+ * CORPORATION). They configure the sensor for a 24 MHz input clock and
+ * RAW10 output over one MIPI CSI-2 lane.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+#include <media/v4l2-subdev.h>
+
+#define OV9726_REG_CHIP_ID		CCI_REG16(0x0000)
+#define OV9726_CHIP_ID			0x9726
+#define OV9726_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define OV9726_MODE_STANDBY		0x00
+#define OV9726_MODE_STREAMING		0x01
+#define OV9726_REG_ORIENTATION		CCI_REG8(0x0101)
+#define OV9726_REG_SOFTWARE_RESET	CCI_REG8(0x0103)
+#define OV9726_REG_COARSE_INTEGRATION	CCI_REG16(0x0202)
+#define OV9726_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define OV9726_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define OV9726_REG_LINE_LENGTH		CCI_REG16(0x0342)
+#define OV9726_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define OV9726_XCLK_FREQ		(24 * HZ_PER_MHZ)
+
+/* 24 MHz / 4 (0x0305) * 70 (0x0307) / 1 (0x0303) / 10 (0x0301) */
+#define OV9726_PIXEL_RATE		(42 * HZ_PER_MHZ)
+/* RAW10 over one lane, DDR */
+#define OV9726_LINK_FREQ		(OV9726_PIXEL_RATE * 10 / 2)
+
+#define OV9726_WIDTH			1296
+#define OV9726_HEIGHT			808
+#define OV9726_LINE_LENGTH		1664
+#define OV9726_FRAME_LENGTH_DEF		840
+#define OV9726_FRAME_LENGTH_MAX		0xffff
+
+#define OV9726_EXPOSURE_MIN		1
+#define OV9726_EXPOSURE_OFFSET		4
+#define OV9726_EXPOSURE_DEF		787
+
+#define OV9726_ANA_GAIN_MIN		0x00
+#define OV9726_ANA_GAIN_MAX		0xff
+#define OV9726_ANA_GAIN_DEF		0x3f
+
+static const char * const ov9726_supply_names[] = {
+	"dovdd",	/* Digital I/O, 1.8 V */
+	"avdd",		/* Analog, 2.8 V */
+};
+
+/*
+ * NVIDIA's 1280x800 mode, without the software reset and the stream on,
+ * which the driver does itself. The output window is 1296x808: the
+ * 1280x800 active area plus border pixels. 30 fps at 1664x840 total.
+ */
+static const struct cci_reg_sequence ov9726_mode_1296x808[] = {
+	{ CCI_REG8(0x3026), 0x00 },
+	{ CCI_REG8(0x3027), 0x00 },
+	{ CCI_REG8(0x3705), 0x45 },
+	{ CCI_REG8(0x3603), 0xaa },
+	{ CCI_REG8(0x3632), 0x2f },
+	{ CCI_REG8(0x3620), 0x66 },
+	{ CCI_REG8(0x3621), 0xc0 },
+	{ CCI_REG8(0x0202), 0x03 },
+	{ CCI_REG8(0x0203), 0x13 },
+	{ CCI_REG8(0x3833), 0x04 },
+	{ CCI_REG8(0x3835), 0x02 },
+	{ CCI_REG8(0x4702), 0x04 },
+	{ CCI_REG8(0x4704), 0x00 },
+	{ CCI_REG8(0x4706), 0x08 },
+	{ CCI_REG8(0x5052), 0x01 },
+	{ CCI_REG8(0x3819), 0x6c },
+	{ CCI_REG8(0x3817), 0x94 },
+	{ CCI_REG8(0x404e), 0x7e },
+	{ CCI_REG8(0x3601), 0x40 },
+	{ CCI_REG8(0x3610), 0xa0 },
+
+	/* Window: x/y start, x/y output size */
+	{ CCI_REG8(0x0344), 0x00 },
+	{ CCI_REG8(0x0345), 0x00 },
+	{ CCI_REG8(0x0346), 0x00 },
+	{ CCI_REG8(0x0347), 0x00 },
+	{ CCI_REG8(0x034c), 0x05 },
+	{ CCI_REG8(0x034d), 0x10 },
+	{ CCI_REG8(0x034e), 0x03 },
+	{ CCI_REG8(0x034f), 0x28 },
+
+	{ CCI_REG8(0x3002), 0x00 },
+	{ CCI_REG8(0x3004), 0x00 },
+	{ CCI_REG8(0x3005), 0x00 },
+	/* MIPI control: continuous clock lane */
+	{ CCI_REG8(0x4800), 0x44 },
+	{ CCI_REG8(0x4801), 0x0f },
+	{ CCI_REG8(0x4803), 0x05 },
+	{ CCI_REG8(0x4601), 0x16 },
+	{ CCI_REG8(0x3014), 0x05 },
+	{ CCI_REG8(0x3707), 0x14 },
+	{ CCI_REG8(0x3622), 0x9f },
+	{ CCI_REG8(0x4002), 0x45 },
+	{ CCI_REG8(0x5001), 0x00 },
+	{ CCI_REG8(0x3406), 0x01 },
+	{ CCI_REG8(0x3503), 0x17 },
+	{ CCI_REG8(0x0205), 0x3f },
+	/* CSI-2 data format: RAW10 */
+	{ CCI_REG8(0x0112), 0x0a },
+	{ CCI_REG8(0x0113), 0x0a },
+	{ CCI_REG8(0x3013), 0x20 },
+	{ CCI_REG8(0x4837), 0x2f },
+	{ CCI_REG8(0x3615), 0xf0 },
+	/* Frame length 840, line length 1664 */
+	{ CCI_REG8(0x0340), 0x03 },
+	{ CCI_REG8(0x0341), 0x48 },
+	{ CCI_REG8(0x0342), 0x06 },
+	{ CCI_REG8(0x0343), 0x80 },
+	{ CCI_REG8(0x3702), 0x1e },
+	{ CCI_REG8(0x3703), 0x3c },
+	{ CCI_REG8(0x3704), 0x0e },
+
+	/* PLL */
+	{ CCI_REG8(0x3104), 0x20 },
+	{ CCI_REG8(0x0305), 0x04 },
+	{ CCI_REG8(0x0307), 0x46 },
+	{ CCI_REG8(0x0303), 0x01 },
+	{ CCI_REG8(0x0301), 0x0a },
+	{ CCI_REG8(0x3010), 0x01 },
+	{ CCI_REG8(0x460e), 0x00 },
+
+	{ CCI_REG8(0x5000), 0x00 },
+	{ CCI_REG8(0x5002), 0x00 },
+	{ CCI_REG8(0x3017), 0xd2 },
+	{ CCI_REG8(0x3018), 0x69 },
+	{ CCI_REG8(0x3019), 0x96 },
+	{ CCI_REG8(0x5047), 0x61 },
+	{ CCI_REG8(0x3604), 0x1c },
+	{ CCI_REG8(0x3602), 0x10 },
+	{ CCI_REG8(0x3612), 0x21 },
+	{ CCI_REG8(0x3630), 0x0a },
+	{ CCI_REG8(0x3631), 0x53 },
+	{ CCI_REG8(0x3633), 0x70 },
+	{ CCI_REG8(0x4005), 0x1a },
+	{ CCI_REG8(0x4009), 0x10 },
+};
+
+static const s64 ov9726_link_freqs[] = {
+	OV9726_LINK_FREQ,
+};
+
+static const char * const ov9726_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Color",
+	"Color Bars",
+	"Fade to Grey Color Bars",
+	"PN9",
+};
+
+struct ov9726 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset;
+	struct gpio_desc *powerdown;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(ov9726_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler hdl;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+static inline struct ov9726 *to_ov9726(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov9726, sd);
+}
+
+/* -----------------------------------------------------------------------------
+ * Controls
+ */
+
+static int ov9726_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov9726 *sensor = container_of(ctrl->handler, struct ov9726, hdl);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 max = OV9726_HEIGHT + ctrl->val - OV9726_EXPOSURE_OFFSET;
+
+		ret = __v4l2_ctrl_modify_range(sensor->exposure,
+					       sensor->exposure->minimum, max,
+					       sensor->exposure->step,
+					       min(sensor->exposure->default_value,
+						   max));
+		if (ret)
+			return ret;
+	}
+
+	/* Only write to the sensor while it is powered up */
+	if (!pm_runtime_get_if_in_use(sensor->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(sensor->regmap, OV9726_REG_COARSE_INTEGRATION,
+			  ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(sensor->regmap, OV9726_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(sensor->regmap, OV9726_REG_FRAME_LENGTH,
+			  OV9726_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		cci_write(sensor->regmap, OV9726_REG_ORIENTATION,
+			  sensor->hflip->val | sensor->vflip->val << 1, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(sensor->regmap, OV9726_REG_TEST_PATTERN, ctrl->val,
+			  &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov9726_ctrl_ops = {
+	.s_ctrl = ov9726_set_ctrl,
+};
+
+static int ov9726_init_controls(struct ov9726 *sensor)
+{
+	const struct v4l2_ctrl_ops *ops = &ov9726_ctrl_ops;
+	struct v4l2_ctrl_handler *hdl = &sensor->hdl;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int vblank_def = OV9726_FRAME_LENGTH_DEF - OV9726_HEIGHT;
+	int hblank = OV9726_LINE_LENGTH - OV9726_WIDTH;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 11);
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, OV9726_PIXEL_RATE,
+			  OV9726_PIXEL_RATE, 1, OV9726_PIXEL_RATE);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(ov9726_link_freqs) - 1, 0,
+				      ov9726_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK, hblank, hblank,
+				 1, hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->vblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+					   vblank_def,
+					   OV9726_FRAME_LENGTH_MAX - OV9726_HEIGHT,
+					   1, vblank_def);
+
+	sensor->exposure = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+					     OV9726_EXPOSURE_MIN,
+					     OV9726_FRAME_LENGTH_DEF -
+					     OV9726_EXPOSURE_OFFSET,
+					     1, OV9726_EXPOSURE_DEF);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN,
+			  OV9726_ANA_GAIN_MIN, OV9726_ANA_GAIN_MAX, 1,
+			  OV9726_ANA_GAIN_DEF);
+
+	/* NVIDIA's settings mirror the image horizontally */
+	sensor->hflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP, 0, 1, 1, 1);
+	sensor->vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP, 0, 1, 1, 0);
+
+	v4l2_ctrl_new_std_menu_items(hdl, ops, V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov9726_test_pattern_menu) - 1,
+				     0, 0, ov9726_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	sensor->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * Subdev operations
+ */
+
+static int ov9726_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct ov9726 *sensor = to_ov9726(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(sensor->regmap, ov9726_mode_1296x808,
+				  ARRAY_SIZE(ov9726_mode_1296x808), NULL);
+	if (ret) {
+		dev_err(sensor->dev, "failed to set the mode: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(&sensor->hdl);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(sensor->regmap, OV9726_REG_MODE_SELECT,
+			OV9726_MODE_STREAMING, NULL);
+	if (ret) {
+		dev_err(sensor->dev, "failed to start streaming: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	/* Flipping changes the Bayer order, so not while streaming */
+	__v4l2_ctrl_grab(sensor->hflip, true);
+	__v4l2_ctrl_grab(sensor->vflip, true);
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sensor->dev);
+	return ret;
+}
+
+static int ov9726_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct ov9726 *sensor = to_ov9726(sd);
+	int ret;
+
+	ret = cci_write(sensor->regmap, OV9726_REG_MODE_SELECT,
+			OV9726_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(sensor->dev, "failed to stop streaming: %d\n", ret);
+
+	__v4l2_ctrl_grab(sensor->hflip, false);
+	__v4l2_ctrl_grab(sensor->vflip, false);
+
+	pm_runtime_put_autosuspend(sensor->dev);
+
+	return ret;
+}
+
+static void ov9726_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = OV9726_WIDTH;
+	fmt->height = OV9726_HEIGHT;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int ov9726_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int ov9726_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index > 0 || fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = OV9726_WIDTH;
+	fse->max_width = OV9726_WIDTH;
+	fse->min_height = OV9726_HEIGHT;
+	fse->max_height = OV9726_HEIGHT;
+
+	return 0;
+}
+
+static int ov9726_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *format)
+{
+	struct v4l2_mbus_framefmt *fmt;
+
+	/* There is one mode and one format */
+	fmt = v4l2_subdev_state_get_format(state, format->pad);
+	ov9726_fill_format(fmt);
+	format->format = *fmt;
+
+	return 0;
+}
+
+static int ov9726_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV9726_WIDTH;
+		sel->r.height = OV9726_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int ov9726_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	ov9726_fill_format(v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov9726_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov9726_pad_ops = {
+	.enum_mbus_code = ov9726_enum_mbus_code,
+	.enum_frame_size = ov9726_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = ov9726_set_fmt,
+	.get_selection = ov9726_get_selection,
+	.enable_streams = ov9726_enable_streams,
+	.disable_streams = ov9726_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov9726_subdev_ops = {
+	.video = &ov9726_video_ops,
+	.pad = &ov9726_pad_ops,
+};
+
+static const struct media_entity_operations ov9726_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static const struct v4l2_subdev_internal_ops ov9726_internal_ops = {
+	.init_state = ov9726_init_state,
+};
+
+/* -----------------------------------------------------------------------------
+ * Power management
+ */
+
+static int ov9726_power_on(struct ov9726 *sensor)
+{
+	int ret;
+
+	gpiod_set_value_cansleep(sensor->reset, 1);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies),
+				    sensor->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sensor->xclk);
+	if (ret)
+		goto err_regulators;
+
+	gpiod_set_value_cansleep(sensor->powerdown, 0);
+	usleep_range(5000, 6000);
+
+	gpiod_set_value_cansleep(sensor->reset, 0);
+	usleep_range(20000, 21000);
+
+	ret = cci_write(sensor->regmap, OV9726_REG_SOFTWARE_RESET, 0x01, NULL);
+	if (ret)
+		goto err_clk;
+	usleep_range(10000, 11000);
+
+	return 0;
+
+err_clk:
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	gpiod_set_value_cansleep(sensor->powerdown, 1);
+	clk_disable_unprepare(sensor->xclk);
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	return ret;
+}
+
+static void ov9726_power_off(struct ov9726 *sensor)
+{
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(sensor->powerdown, 1);
+
+	clk_disable_unprepare(sensor->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+}
+
+static int ov9726_runtime_resume(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+
+	return ov9726_power_on(to_ov9726(sd));
+}
+
+static int ov9726_runtime_suspend(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+
+	ov9726_power_off(to_ov9726(sd));
+
+	return 0;
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov9726_pm_ops, ov9726_runtime_suspend,
+				 ov9726_runtime_resume, NULL);
+
+/* -----------------------------------------------------------------------------
+ * Probe and remove
+ */
+
+static int ov9726_identify(struct ov9726 *sensor)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(sensor->regmap, OV9726_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret,
+				     "failed to read the chip ID\n");
+
+	if (id != OV9726_CHIP_ID)
+		return dev_err_probe(sensor->dev, -ENODEV,
+				     "unexpected chip ID 0x%04llx\n", id);
+
+	return 0;
+}
+
+static int ov9726_check_endpoint(struct ov9726 *sensor)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *ep;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!ep)
+		return dev_err_probe(sensor->dev, -EINVAL, "no endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret,
+				     "failed to parse the endpoint\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != 1)
+		return dev_err_probe(sensor->dev, -EINVAL,
+				     "only one data lane is supported\n");
+
+	return 0;
+}
+
+static int ov9726_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov9726 *sensor;
+	unsigned int i;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->dev = dev;
+
+	ret = ov9726_check_endpoint(sensor);
+	if (ret)
+		return ret;
+
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return dev_err_probe(dev, PTR_ERR(sensor->regmap),
+				     "failed to initialize the register map\n");
+
+	sensor->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sensor->xclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->xclk),
+				     "failed to get the clock\n");
+
+	if (clk_get_rate(sensor->xclk) != OV9726_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "unsupported clock rate %lu Hz\n",
+				     clk_get_rate(sensor->xclk));
+
+	sensor->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset),
+				     "failed to get the reset GPIO\n");
+
+	sensor->powerdown = devm_gpiod_get_optional(dev, "powerdown",
+						    GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->powerdown))
+		return dev_err_probe(dev, PTR_ERR(sensor->powerdown),
+				     "failed to get the powerdown GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(sensor->supplies); i++)
+		sensor->supplies[i].supply = ov9726_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sensor->supplies),
+				      sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the supplies\n");
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &ov9726_subdev_ops);
+	sensor->sd.internal_ops = &ov9726_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->sd.entity.ops = &ov9726_entity_ops;
+
+	ret = ov9726_power_on(sensor);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = ov9726_identify(sensor);
+	if (ret)
+		goto err_power_off;
+
+	ret = ov9726_init_controls(sensor);
+	if (ret)
+		goto err_power_off;
+
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto err_ctrls;
+
+	sensor->sd.state_lock = sensor->hdl.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register the subdev\n");
+		goto err_pm;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+err_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&sensor->hdl);
+err_power_off:
+	ov9726_power_off(sensor);
+	return ret;
+}
+
+static void ov9726_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov9726 *sensor = to_ov9726(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sensor->hdl);
+
+	pm_runtime_disable(sensor->dev);
+	if (!pm_runtime_status_suspended(sensor->dev)) {
+		ov9726_power_off(sensor);
+		pm_runtime_set_suspended(sensor->dev);
+	}
+}
+
+static const struct of_device_id ov9726_of_match[] = {
+	{ .compatible = "ovti,ov9726" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov9726_of_match);
+
+static struct i2c_driver ov9726_driver = {
+	.driver = {
+		.name = "ov9726",
+		.of_match_table = ov9726_of_match,
+		.pm = pm_ptr(&ov9726_pm_ops),
+	},
+	.probe = ov9726_probe,
+	.remove = ov9726_remove,
+};
+module_i2c_driver(ov9726_driver);
+
+MODULE_DESCRIPTION("OmniVision OV9726 image sensor driver");
+MODULE_LICENSE("GPL");
