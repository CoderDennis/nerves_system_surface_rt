# Kernel config fragment for the Microsoft Surface RT
#
# Applied on top of the kernel's tegra_defconfig. See nerves_defconfig.
# Drivers that tegra_defconfig already enables aren't repeated here:
# Tegra DRM, LVDS codec and panel, PWM backlight, Tegra I2C and SDHCI,
# TPS65911 PMIC (MFD, regulators, RTC), TPS62361 regulator, NCT1008
# temperature sensor (LM90), GPIO keys and ChipIdea USB host.
#
# TODO: Replace tegra_defconfig + this fragment with a full
# linux-<version>.defconfig like the other Nerves systems use.

# UEFI boot: GRUB (arm-efi) loads zImage through the EFI stub
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Nerves root filesystem, boot partition and application partition
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# VintageNet's RouteManager adds an "ip rule" and a routing table per
# interface. Without these, it fails with "Address family not supported by
# protocol" and the interface never stays connected.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# USB Ethernet adapters for development (the Surface RT has no Ethernet)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y

# Wi-Fi: Marvell 88W8797 on SDIO, powered through an mmc-pwrseq-simple node.
# The firmware comes from BR2_PACKAGE_LINUX_FIRMWARE_MWIFIEX_SD8797, and
# regulatory.db from BR2_PACKAGE_WIRELESS_REGDB. These are modules so that
# they load after the root filesystem is mounted. Built in, mwifiex asks
# for its firmware about 4 seconds into the boot, before the rootfs is
# there, and the interface never appears.
#
# linux/0002-wifi-mwifiex-Name-the-station-interface-wlan0.patch renames
# the interface from mwifiex's "mlan0" to the "wlan0" Nerves expects.
CONFIG_CFG80211=m
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_SDIO=m
CONFIG_PWRSEQ_SIMPLE=y

# Console on the built-in screen. efifb shows boot messages on the UEFI
# framebuffer until Tegra DRM takes over.
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_SYSFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Touchscreen (Atmel maXTouch), sensor hub and Touch/Type Cover, all HID
# over I2C. The cover's I2C bus is only connected while a cover is
# attached (i2c-hotplug-gpio, linux/0011).
CONFIG_HID=y
CONFIG_I2C_HID_CORE=y
CONFIG_I2C_HID_OF=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_SENSOR_HUB=y
CONFIG_I2C_HOTPLUG_GPIO=y

# Battery and charger (embedded controller) and audio (WM8962 codec). Both
# drivers were added to mainline after 6.18 and are backported in
# linux/0008-0010.
CONFIG_BATTERY_CHARGER_SURFACE_RT=y
CONFIG_SND_SOC_TEGRA_WM8962=y

# Camera interface (VI and CSI). Tegra30 support was added to the staging
# tegra-video driver in Linux 7.1 and is backported in linux/0015-0042.
# Both cameras are OV9726 sensors (linux/0043-0044, not in mainline).
CONFIG_VIDEO_TEGRA=y
CONFIG_VIDEO_OV9726=y

# Hardware watchdog, petted by nerves_heart. Use the PMIC's watchdog
# (linux/0014), which power-cycles the Surface RT. The Tegra watchdog's
# reset goes through the PMC and leaves the screen black instead of
# restarting. NOWAYOUT matches the official Nerves systems: the watchdog
# can't be stopped once nerves_heart has started it.
# CONFIG_TEGRA_WATCHDOG is not set
CONFIG_TPS65911_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y
