# boardid.config

# Read the serial number from the U-boot environment block.
-b uboot_env -u nerves_serial_number

# TODO: Untested. The Surface RT's UEFI firmware provides SMBIOS tables to
# Windows, which may expose the device serial number here if the kernel
# makes them available.
-b dmi

# The Surface RT has no Ethernet port, so this only works with a USB
# Ethernet adapter attached.
-b macaddr
